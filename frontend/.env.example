# Copy to .env.local (git-ignored) for local development. All three are
# needed; the desk has no sample-data mode.
#
# Production builds (Vercel) do not use this file: they read
# .env.production, which is committed because every value in it is public.

# The FastAPI backend. No trailing slash.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Staff login (Supabase Auth): Supabase > Project Settings > API, the Project
# URL and the publishable key. Leave both empty, with AUTH_REQUIRED=false in
# backend/app/.env, to work locally without signing in.
VITE_SUPABASE_URL=https://yxhnejjquxiretpxxxvm.supabase.co
VITE_SUPABASE_ANON_KEY=
