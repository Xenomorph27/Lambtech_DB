# Copy this file to .env in the same folder and fill in real values.
# .env is git-ignored. Never commit real credentials.

# Supabase > Project Settings > Database > Connection string > Session pooler.
# DATABASE_URL=postgresql://postgres.yxhnejjquxiretpxxxvm:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Browser origins allowed to call this API, comma separated: the Vite dev
# server, plus the deployed frontend once it exists.
CORS_ORIGINS=http://localhost:5173

# --- Staff login (Supabase Auth) ---------------------------------------------
# true in every deployment. Only your own local .env may set false.
AUTH_REQUIRED=true
# Supabase > Project Settings > API > Project URL
SUPABASE_URL=https://yxhnejjquxiretpxxxvm.supabase.co
# Only for projects that still sign tokens with the legacy JWT secret.
SUPABASE_JWT_SECRET=
# Comma separated. Only these people can use the desk.
STAFF_EMAILS=
